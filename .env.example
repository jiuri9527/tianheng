# =============================================================================
# 天衡（Tianheng）通用大模型 API 聚合中转站 —— 完整环境变量模板
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env 后填入真实值；docker compose 会自动读取 .env。
# 本文件逐条对齐 src/internal/config/config.go 与各包 os.Getenv 真实读取的 key，
# 一个不漏（核对命令见文件末尾）。
#
# 天衡的两条核心语义：
#   1) 所有用户都是超级用户，没有任何管理员角色（role 恒为 superuser）；
#   2) 不设任何使用限制：无 RPM/TPM/并发/配额/IP 白名单/过期时间。
#      因此下面的 RATE_* 默认值均为 0（0 = 不限）。
# =============================================================================

# --------------------------- 服务与身份 ---------------------------
SERVER_PORT=8080
# 对外基址（用于生成调用示例与 OpenAPI 文档里的 servers）
SERVER_BASE_URL=https://[DEPLOY_HOST]

# JWT 签名密钥（HS256）。留空时启动生成临时随机密钥并告警，重启即失效。
JWT_SECRET=[JWT_SECRET]
# JWT 有效期（分钟）
JWT_TTL_MIN=1440

# 上游 api_key 的 AES-256-GCM 主密钥：32 字节 base64。
# 生成：python3 -c 'import os,base64;print(base64.b64encode(os.urandom(32)).decode())'
# 缺失时服务拒绝启动（绝不回退到源码内可推导密钥）。
MASTER_KEY=[32字节base64_AES256密钥]
# 密钥轮换窗口内的旧主密钥（轮换完成后必须清空）
MASTER_KEY_PREVIOUS=

# --------------------------- 真实模型数据 ---------------------------
# 唯一真实数据源（460 模型 / 69 供应商，抓取自 https://openrouter.ai/api/v1/models）
REAL_MODELS_PATH=data/models-real.json
# 模型同步 cron（渠道模型定时刷新）
MODEL_SYNC_CRON=0 */6 * * *
# 自动发现刷新间隔（秒）。填密钥后站点自动 GET {base_uri}/models，无需用户填写模型。
MODEL_AUTO_REFRESH_SEC=21600

# 真实探测（每个模型发一次极小真实请求采集输入/输出样例）
PROBE_ENABLED=true
PROBE_MAX_TOKENS=16

# --------------------------- 反代理与并发 ---------------------------
# 上游请求超时（秒）
DEFAULT_TIMEOUT_SEC=180
# 上游失败后最多切换几个候选渠道
MAX_FAILOVER=3
# 渠道熔断冷却（秒）
CIRCUIT_COOLDOWN_SEC=30
# 渠道健康检查间隔（秒）
HEALTH_CHECK_INTERVAL_SEC=60
# 请求体上限（MB）
BODY_LIMIT_MB=20

# --------------------------- 使用限制（天衡：全部为 0 = 不限）---------------------------
# 0 = 不限制。天衡不设任何 token 使用限制、并发限制或设备限制。
RATE_RPM_DEFAULT=0
RATE_TPM_DEFAULT=0
# 贡献公开渠道的奖励比例（仅记账展示，不构成任何调用限制）
CONTRIBUTOR_REWARD_RATE=0.15

# --------------------------- 攻防防火墙 ---------------------------
# 认证失败次数阈值（达到后按攻击处理，累计分数）
FIREWALL_AUTH_FAILURE_THRESHOLD=5
# 触发自动封禁的累计攻击分数阈值
FIREWALL_BLOCK_SCORE=8
# 达到该被封 IP 数量时升级为全局 lockdown + 数据封存
FIREWALL_LOCKDOWN_IP_THRESHOLD=3
# lockdown 冷却秒数（到期后 level 降级，但 sealed 需本机显式解锁）
FIREWALL_LOCKDOWN_TTL_SEC=600
# 速率突发检测阈值（每 10s 窗口请求数）；属攻击检测，不是使用限制。
# 默认放宽到 5000，避免移除限流后把正常高频调用误判为攻击。
FIREWALL_BURST_THRESHOLD=5000

# --------------------------- 实时监控 ---------------------------
# 同时打开的 /api/telemetry/stream SSE 连接上限（超出返回 503）
TELEMETRY_STREAM_MAX_CONNS=256

# --------------------------- 日志与隐私 ---------------------------
# 是否记录每次调用的完整输入/输出（天衡的请求日志能力依赖此开关）
LOG_FULL_BODY=true
# 是否对上游 key 等敏感串做脱敏（强烈建议 true）
LOG_MASK_KEYS=true

# --------------------------- 本机开发/靶场 ---------------------------
# 允许把回环/内网地址作为上游 base_uri。
# 默认关闭：生产部署不设此变量时，SSRF 防护（拒绝 127/8、RFC1918、169.254 元数据）
# 与原来完全一致。仅本机联调与本机靶场需要设为 1。
ALLOW_PRIVATE_UPSTREAM=0

# --------------------------- 持久化 ---------------------------
# 状态目录（JSON 存储 + WAL + 完整性链 + 备份 + 头像 + 论坛数据）
DATA_DIR=./.tianheng-data

# --------------------------- 注册与跨域 ---------------------------
REGISTRATION_OPEN=true
CORS_ORIGINS=*

# --------------------------- 引导账号 ---------------------------
# 首个引导账号（同样只是超级用户，没有任何管理员特权）
ADMIN_EMAIL=[ADMIN_EMAIL]
ADMIN_PASSWORD=[ADMIN_PASSWORD]

# --------------------------- 前端（Next.js）---------------------------
# 前端把 /api 与 /v1 反向代理到该 Go 网关地址。
# 注意：Next.js 的 rewrites 在 build 时烘焙进 routes-manifest，
# 更换后端地址必须带该变量重新 `npm run build`。
LLM_HUB_BACKEND_ORIGIN=http://127.0.0.1:8080
# 前端展示用的部署域名（生成 curl / SDK 示例）
NEXT_PUBLIC_DEPLOY_HOST=https://[DEPLOY_HOST]

# =============================================================================
# 核对命令（应输出空差集）：
#   grep -oE 'get(env|int|bool|float|intBounded|duration)\("[A-Z_0-9]+"' \
#     src/internal/config/config.go | sed 's/.*("//;s/"$//' | sort -u > /tmp/keys.txt
#   grep -oE '^[A-Z][A-Z_0-9]+=' .env.example | sed 's/=$//' | sort -u > /tmp/tpl.txt
#   comm -23 /tmp/keys.txt /tmp/tpl.txt   # 应为空
# =============================================================================
