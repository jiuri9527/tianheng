diff --git a/src/internal/health/health.go b/src/internal/health/health.go
--- a/src/internal/health/health.go
+++ b/src/internal/health/health.go
@@ -112,20 +112,23 @@
 	models, err := c.Discoverer.ListModels(checkCtx, ch)
