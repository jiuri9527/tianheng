 		}
-	} else {
-		ch.FailCount = 0
-		ch.LastError = ""
-		ch.CooldownUntil = 0
-		_ = models // 轻量探测成功即视为健康，不改动已发现的真实模型
+	})
+	if failed && c.Router != nil {
+		c.Router.SetCooldown(ch.ID, time.Now().Add(30*time.Second))
 	}
-	c.St.UpdateChannel(ch)
 }
