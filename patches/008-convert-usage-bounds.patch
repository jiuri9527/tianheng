+// maxUsageTokens 上游 usage 字段不可信：钳制到合法范围，防止负数/溢出污染计费。
+const maxUsageTokens = 1 << 31
+
+func safeUsageInt(n int) int {
+	if n < 0 || n > maxUsageTokens {
+		return 0
+	}
+	return n
+}
 
