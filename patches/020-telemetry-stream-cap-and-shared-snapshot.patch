+var streamConns atomic.Int64
+
+var (
+	snapMu       sync.Mutex
+	snapCached   Snapshot
+	snapCachedAt time.Time
+)
+
+// cachedAggregate 同一 streamInterval 内的所有连接共享同一份聚合：
+// 每 interval 至多执行一次全量扫描，防止 N 连接放大成 N 次聚合。
+func cachedAggregate(st *store.Store, now time.Time) Snapshot {
+	snapMu.Lock()
+	defer snapMu.Unlock()
+	if now.Sub(snapCachedAt) < streamInterval && !snapCachedAt.IsZero() {
+		return snapCached
+	}
+	snapCached = aggregate(st, now)
+	snapCachedAt = now
+	return snapCached
+}
