+// sanitizeRequestID 只保留 [A-Za-z0-9_-] 且限长，防止客户端通过 X-Request-Id
+// 注入换行伪造日志行、或碰撞他人日志索引（logsByReqID 按 request_id 索引）。
+func sanitizeRequestID(s string) string {
+	if len(s) > 64 {
+		s = s[:64]
+	}
+	out := make([]byte, 0, len(s))
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') || c == '-' || c == '_' {
+			out = append(out, c)
+		}
+	}
+	return string(out)
+}
