+}
+
+// runTask 隔离任务 panic：单个任务处理不可信上游数据时崩溃不得终止整个进程。
+func runTask(fn func(context.Context) error, ctx context.Context) (err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("rt: task panic: %v", r)
+		}
+	}()
+	return fn(ctx)
 }
 
