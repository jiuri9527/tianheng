# llm-hub 环境变量模板 —— 复制为 .env 后填入真实值
# 所有 [占位符] 必须由部署者填写；模型数据一律来自 data/models-real.json，禁止伪造。

SERVER_ADDR=:8080
SERVER_BASE_URL=https://[DEPLOY_HOST]
ENV=production
LOG_LEVEL=info

# 真实模型数据（唯一真值源，HTTP 200 抓取自 https://openrouter.ai/api/v1/models）
MODELS_REAL_PATH=/app/data/models-real.json
MODELS_SYNC_CRON=0 */6 * * *
PROBE_ENABLED=true
PROBE_MAX_TOKENS=16
PROBE_TIMEOUT_SEC=30

# 上游凭据加密（AES-256-GCM）；MASTER_KEY 为 32 字节 base64，丢失则旧密文不可解
MASTER_KEY=[32字节base64_AES256密钥]
MASTER_KEY_PREVIOUS=
KEY_ROTATION_INTERVAL_H=720

# 持久化（零第三方依赖：JSON 文件 + 内存索引）
STATE_DIR=/app/state
STATE_FLUSH_MS=250

# JWT / 平台令牌
JWT_SECRET=[JWT_SECRET]
JWT_TTL_MIN=1440
TOKEN_PREFIX=sk-
TOKEN_HASH_ALGO=sha256

# 反代理与并发
DEFAULT_TIMEOUT_SEC=180
MAX_FAILOVER=3
CIRCUIT_COOLDOWN_SEC=30
HEALTH_CHECK_INTERVAL_SEC=60
MAX_BODY_MB=20
SSE_FLUSH_EVERY_BYTES=0
SCHEDULER_WORKERS=32
SCHEDULER_QUEUE_CAPACITY=65536
STREAMPIPE_BUFFER_BYTES=65536
POOL_MAX_IDLE=64

# 限流与配额
RATE_RPM_DEFAULT=60
RATE_TPM_DEFAULT=200000
RATE_CONCURRENCY_DEFAULT=8
CONTRIBUTOR_REWARD_RATE=0.15
QUOTA_DECIMALS=6

# 安全
SSRF_DENY_PRIVATE=true
SSRF_DNS_RECHECK=true
LOG_FULL_BODY=true
LOG_MASK_KEYS=true
CORS_ORIGINS=*
REGISTRATION_OPEN=true

# 管理面初始账号
ADMIN_EMAIL=[ADMIN_EMAIL]
ADMIN_PASSWORD=[ADMIN_PASSWORD]

# 运行时上游凭据（由用户在「贡献渠道」页面提交，不写进环境变量）
# XAI_BASE_URI=https://api.x.ai/v1
# ANTHROPIC_BASE_URI=https://api.anthropic.com/v1
# OPENAI_BASE_URI=https://api.openai.com/v1
# GEMINI_BASE_URI=https://generativelanguage.googleapis.com/v1beta/openai
